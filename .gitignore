# =============================================
# Kirikiri Grav — Skinny repo
# Repos hoitakse AINULT: teema (kirikiri), sisu, config, blueprintid.
# Grav tuum, pluginad ja vaiketeemad uuenevad admin/GPM kaudu.
# =============================================

# --- Grav tuum (GPM selfupgrade kaudu) ---
/system/
/vendor/
/index.php
/bin/
/composer.json
/composer.lock
/now.json
/webserver-configs/

# --- Pluginad (admin/GPM kaudu) ---
/user/plugins/*
!/user/plugins/.gitkeep

# --- Teemad: ainult kirikiri hoitakse repos ---
/user/themes/*
!/user/themes/.gitkeep
!/user/themes/kirikiri/

# --- Kontod (turvalisus — parooli hash'id) ---
/user/accounts/*
!/user/accounts/.gitkeep

# --- Runtime andmed ---
/user/data/*
!/user/data/.gitkeep

# --- Grav genereeritud kaustad ---
/cache/
/logs/
/images/
/assets/
/backup/
/tmp/
/.thumbs

# --- OS ---
.DS_Store
Thumbs.db
.ds_store

# --- Saladused ---
.env

# Grav 2.0 auto-genereeritud saladused (CSRF salt, API JWT võti).
# Kirjutatakse 0600 õigustega, taastuvad ise, kui kustutada.
/user/config/security-private.php
/user/config/plugins/*-private.php

# api plugin kirjutab siia popularity-statistika HMAC-soola (külastaja IP
# pseudonüümimiseks). Plugina enda kommentaar: "a committed salt would be
# globally known and defeat the keyed-hash protection entirely."
# Kui siia kunagi tekib päris api-seadistusi, tuleb sool eraldi failiks tõsta.
/user/config/plugins/api.yaml

# migrate-grav wizardi lõpumarker — viitab varukoopiale backup/-is, mis on
# nagunii ignore'itud.
/.migration-complete

# --- Grav'i repo failid (ei kuulu meie reposse) ---
/CHANGELOG.md
/CODE_OF_CONDUCT.md
/CONTRIBUTING.md
/LICENSE.txt
/SECURITY.md
/now.json

# --- Arenduse müra ---
/needs_fixing.txt
